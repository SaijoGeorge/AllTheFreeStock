---
const nav = [
  { label: 'Photos', href: '/#photos' },
  { label: 'Video', href: '/#video' },
  { label: 'Audio', href: '/#audio' },
  { label: 'Icons & Type', href: '/#icons' },
];
---

<header class="sticky top-0 z-50 glass border-x-0 border-t-0">
  <div class="max-w-7xl mx-auto px-5 py-3 flex items-center gap-5">
    <a href="/" class="flex items-center gap-2.5">
      <span class="w-[30px] h-[30px] rounded-[10px]" style="background:linear-gradient(145deg,#7fb9b3,#4d8f8a);box-shadow:0 6px 14px -6px rgba(31,80,76,.7);"></span>
      <span class="font-serif text-[23px] tracking-tight text-ink">allthefreestock</span>
    </a>
    <nav class="hidden md:flex items-center gap-1 ml-3.5">
      {nav.map((item) => (
        <a href={item.href} class="px-3.5 py-2 rounded-full text-sm font-medium text-[#33443f] hover:bg-white/50 no-underline">
          {item.label}
        </a>
      ))}
    </nav>
    <div class="flex-1"></div>
    <form action="/" class="hidden sm:flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/70 border border-white/90 min-w-[220px]">
      <span class="text-[13px] text-[#7b8a85]">⌕</span>
      <input
        name="q"
        class="js-search border-0 outline-none bg-transparent font-sans text-sm w-full text-ink"
        placeholder="Search 400+ resources"
        autocomplete="off"
      />
    </form>
    <a
      href="/blog/"
      class="btn-primary flex items-center gap-2 px-4.5 py-2.5 rounded-full text-sm font-semibold no-underline"
    >
      Blog
      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-md bg-white/20">NEW</span>
    </a>
  </div>
</header>
