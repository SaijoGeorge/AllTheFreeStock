---
interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="flex flex-col gap-2.75">
  {faqs.map((f) => (
    <details class="group rounded-2xl bg-white/58 border border-white/90 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex items-center justify-between gap-3.5 px-4.5 py-3.5 cursor-pointer font-sans font-semibold text-[16.5px] text-[#1f302b] list-none hover:bg-white/50">
        <span>{f.q}</span>
        <span class="text-sm group-open:rotate-180 transition-transform">⌄</span>
      </summary>
      <div class="px-4.5 pb-4.25 text-[15.5px] leading-relaxed text-[#41524c]">{f.a}</div>
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
})} />
