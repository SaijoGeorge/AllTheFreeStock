---
interface Faq {
  q: string;
  a: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="flex flex-col gap-2.75">
  {faqs.map((f) => (
    <div class="rounded-2xl bg-white/58 border border-white/90 px-4.5 py-3.75">
      <h3 class="m-0 font-sans font-semibold text-[16.5px] text-[#1f302b]">{f.q}</h3>
      <p class="mt-2 mb-0 text-[15.5px] leading-relaxed text-[#41524c]">{f.a}</p>
    </div>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
})} />
