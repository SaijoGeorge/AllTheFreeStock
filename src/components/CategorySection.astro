---
import type { ResourceSection } from '../data/resources';
import ResourceCard from './ResourceCard.astro';

interface Props {
  section: ResourceSection;
}

const { section } = Astro.props;

// Group items by subcategory while preserving first-seen order; items with
// no subcategory land in a single unlabeled group.
const groups: { label: string | null; items: typeof section.items }[] = [];
for (const item of section.items) {
  const label = item.subcategory ?? null;
  let group = groups.find((g) => g.label === label);
  if (!group) {
    group = { label, items: [] };
    groups.push(group);
  }
  group.items.push(item);
}
---

<section id={section.id} data-section class="mb-14 scroll-mt-24">
  <div class="flex items-baseline gap-3.5 mb-4.5 flex-wrap">
    <h2 class="font-serif font-normal text-[34px] tracking-tight m-0">{section.title}</h2>
    <span class="text-sm text-[#5e6f69]">{section.blurb}</span>
  </div>
  {groups.map((group) => (
    <div data-group class="mb-7 last:mb-0">
      {group.label && (
        <div class="mb-2.5 font-mono text-[11px] tracking-[0.08em] uppercase text-[#6c7d77]">{group.label}</div>
      )}
      <div class="grid gap-3.5" style="grid-template-columns:repeat(auto-fill,minmax(230px,1fr));">
        {group.items.map((item) => <ResourceCard item={item} />)}
      </div>
    </div>
  ))}
</section>
