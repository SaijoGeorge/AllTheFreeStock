---
import Layout from '../layouts/Layout.astro';
import CategoryRail from '../components/CategoryRail.astro';
import CategorySection from '../components/CategorySection.astro';
import { sections, totalCount, LICENCE_TAGS } from '../data/resources';
---

<Layout title="AllTheFreeStock - Every free stock resource, in one place">
  <main>
    <section class="max-w-7xl mx-auto px-5 pt-[92px] pb-14 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass font-mono text-xs text-[#436059] tracking-wide">
        curated since 2015
      </div>
      <h1 class="font-serif font-normal text-[clamp(42px,6.4vw,78px)] leading-[1.02] tracking-tight mx-auto mt-6" style="text-wrap:balance;">
        Every free stock resource, in one place.
      </h1>
      <p class="max-w-[56ch] mx-auto mt-5 text-lg leading-relaxed text-[#4a5c56]">
        Photos, video, audio, icons, fonts and mockups, so you can grab an asset and get back to work.
      </p>
      <div class="flex justify-center gap-3 mt-7 flex-wrap">
        <div class="flex items-center gap-2.5 px-5 py-3.5 rounded-[18px] glass backdrop-blur-md min-w-[320px] flex-1 max-w-[520px]" style="box-shadow:0 18px 44px -28px rgba(29,62,58,.55);">
          <span class="text-[#7b8a85]">⌕</span>
          <input
            id="hero-search"
            class="js-search border-0 outline-none bg-transparent font-sans text-base w-full text-ink"
            placeholder='Try "illustrations", "drone footage", "icons"…'
            autocomplete="off"
          />
        </div>
      </div>
      <div class="flex justify-center gap-6.5 mt-6.5 flex-wrap font-mono text-xs text-[#56685f]">
        <span>{totalCount} resources</span>
        <span>{sections.length} categories</span>
        <span>0 sign-ups required</span>
      </div>

      <div class="flex justify-center gap-2 mt-6 flex-wrap">
        <button
          type="button"
          data-tag-filter=""
          class="js-tag-filter active px-3 py-1.5 rounded-full text-[12.5px] font-mono glass"
        >
          All licences
        </button>
        {LICENCE_TAGS.map((tag) => (
          <button
            type="button"
            data-tag-filter={tag}
            class="js-tag-filter px-3 py-1.5 rounded-full text-[12.5px] font-mono glass"
          >
            {tag}
          </button>
        ))}
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-5 pb-20 flex items-start gap-9">
      <CategoryRail sections={sections} />
      <div class="flex-1 min-w-0">
        {sections.map((section) => <CategorySection section={section} />)}
        <div data-empty-state hidden class="p-14 text-center rounded-[22px] bg-white/50 border border-dashed border-[#3c6460]/30">
          <div class="font-serif text-2xl">Nothing matches that yet.</div>
          <p class="text-[#5b6c66] text-[15px]">Try a broader word - "photo", "video", "icon".</p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const inputs = document.querySelectorAll<HTMLInputElement>('.js-search');
  const sections = document.querySelectorAll<HTMLElement>('[data-section]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.js-tag-filter');

  let activeTag = '';

  function applyFilter(query: string) {
    const q = query.trim().toLowerCase();
    let anyVisible = false;
    sections.forEach((section) => {
      let sectionHasVisible = false;
      section.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
        const textMatch = !q || (card.dataset.haystack ?? '').includes(q);
        const tagMatch = !activeTag || card.dataset.tag === activeTag;
        const match = textMatch && tagMatch;
        card.hidden = !match;
        if (match) sectionHasVisible = true;
      });
      section.querySelectorAll<HTMLElement>('[data-group]').forEach((group) => {
        group.hidden = !group.querySelector('[data-card]:not([hidden])');
      });
      section.hidden = !sectionHasVisible;
      if (sectionHasVisible) anyVisible = true;
    });
    if (emptyState) emptyState.hidden = anyVisible || (!q && !activeTag);
  }

  inputs.forEach((input) => {
    input.addEventListener('input', () => {
      inputs.forEach((other) => {
        if (other !== input) other.value = input.value;
      });
      applyFilter(input.value);
    });
  });

  tagButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTag = btn.dataset.tagFilter ?? '';
      tagButtons.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('active', isActive);
        b.classList.toggle('bg-teal-700', isActive);
        b.classList.toggle('text-white', isActive);
      });
      applyFilter(inputs[0]?.value ?? '');
    });
  });

  const params = new URLSearchParams(location.search);
  const initialQuery = params.get('q');
  if (initialQuery) {
    inputs.forEach((input) => (input.value = initialQuery));
    applyFilter(initialQuery);
  }
</script>
