---
import Layout from '../layouts/Layout.astro';
import CategoryRail from '../components/CategoryRail.astro';
import CategorySection from '../components/CategorySection.astro';
import { sections, totalCount } from '../data/resources';
---

<Layout title="AllTheFreeStock — Every free stock resource, in one calm place">
  <main>
    <section class="max-w-7xl mx-auto px-5 pt-[92px] pb-14 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass font-mono text-xs text-[#436059] tracking-wide">
        curated since 2015 · updated weekly
      </div>
      <h1 class="font-serif font-normal text-[clamp(42px,6.4vw,78px)] leading-[1.02] tracking-tight mx-auto mt-6 max-w-[15ch]" style="text-wrap:balance;">
        Every free stock resource, in one calm place.
      </h1>
      <p class="max-w-[56ch] mx-auto mt-5 text-lg leading-relaxed text-[#4a5c56]">
        Photos, video, audio, icons, fonts and mockups — hand-checked for licence clarity, so you can grab an asset and get back to work.
      </p>
      <form action="/search/" class="flex justify-center gap-3 mt-7 flex-wrap">
        <div class="flex items-center gap-2.5 px-5 py-3.5 rounded-[18px] glass backdrop-blur-md min-w-[320px] flex-1 max-w-[520px]" style="box-shadow:0 18px 44px -28px rgba(29,62,58,.55);">
          <span class="text-[#7b8a85]">⌕</span>
          <input
            name="q"
            placeholder='Try "illustrations", "drone footage", "icons"…'
            class="border-0 outline-none bg-transparent font-sans text-base w-full text-ink"
          />
        </div>
      </form>
      <div class="flex justify-center gap-6.5 mt-6.5 flex-wrap font-mono text-xs text-[#56685f]">
        <span>{totalCount} resources</span>
        <span>{sections.length} categories</span>
        <span>0 sign-ups required</span>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-5 pb-20 flex items-start gap-9">
      <CategoryRail sections={sections} />
      <div class="flex-1 min-w-0">
        {sections.map((section) => <CategorySection section={section} />)}
      </div>
    </section>
  </main>
</Layout>
