---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - AllTheFreeStock" description="This page doesn't exist." noindex>
  <main class="max-w-[640px] mx-auto px-5 pt-24 pb-24 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass font-mono text-xs text-[#436059]">
      404
    </div>
    <h1 class="font-serif font-normal text-[clamp(38px,5.4vw,56px)] tracking-tight mt-6">Nothing here.</h1>
    <p class="mt-4 text-lg leading-relaxed text-[#4a5c56]">
      That page doesn't exist - it may have moved, or the link's just wrong. Try the homepage, or search from there.
    </p>
    <a
      href="/"
      class="inline-block mt-7 btn-primary px-6 py-3.5 rounded-full text-[15px] font-semibold no-underline"
    >
      Back to AllTheFreeStock
    </a>
  </main>
</Layout>
