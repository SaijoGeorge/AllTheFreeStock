---
import Layout from '../../layouts/Layout.astro';
import { sections } from '../../data/resources';

// Replace with a real Stripe Payment Link once one exists:
// Stripe Dashboard -> Payment Links -> new $50 USD one-time product.
// Configure it with these custom fields so submissions are captured
// directly at checkout (Stripe Dashboard -> that Payment Link -> Custom
// fields): Brand name (text), Link (text), Section (dropdown - use the
// category names below), Licence (dropdown - use LICENCE_TAGS in
// src/data/resources.ts, currently 10 values), Description (text, set
// "maximum characters" to ~40 to keep it roughly 6 words).
const STRIPE_PAYMENT_LINK = 'https://buy.stripe.com/14AfZh3J13ghb45bR6dEs01';

const sectionNames = sections.map((s) => s.title);
---

<Layout title="Submit a Resource - AllTheFreeStock" description="Submit a free (or freemium) resource to the AllTheFreeStock directory.">
  <main class="max-w-[640px] mx-auto px-5 pt-20 pb-24">
    <h1 class="font-serif font-normal text-[clamp(38px,5.4vw,56px)] tracking-tight m-0">Submit a resource</h1>
    <p class="mt-4 text-lg leading-relaxed text-[#4a5c56]">
      Know a good site we're missing? Submissions are handled through checkout below - pay the fee, fill in the
      details, and it goes into the review queue.
    </p>

    <div class="mt-3 inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass font-mono text-xs text-[#436059]">
      $50 USD - one-time submission fee
    </div>

    <div class="mt-8 p-6 rounded-[22px] glass-card">
      <div class="text-sm font-semibold text-ink mb-3">You'll be asked for:</div>
      <ul class="flex flex-col gap-2 text-[15px] text-[#4a5c56] m-0 pl-5">
        <li>Brand name</li>
        <li>Link</li>
        <li>Section - which part of the directory it belongs in ({sectionNames.join(', ')})</li>
        <li>Licence - CC0, site licence, CC BY, freemium, paid, etc.</li>
        <li>A short description (6 words max)</li>
      </ul>
      <p class="mt-4 text-[13px] text-[#7a8a84]">
        If the licence isn't fully free, the listing is marked with a <span class="px-2 py-0.5 rounded-full bg-[#fdf3c8] text-[#8a6d1f] font-mono text-[11px]">paid</span> pill once it's live.
      </p>
    </div>

    <a
      href={STRIPE_PAYMENT_LINK}
      target="_blank"
      rel="noopener"
      class="mt-6 block text-center btn-primary px-5 py-4 rounded-full text-[15px] font-semibold no-underline"
    >
      Continue to checkout - $50 USD
    </a>
    <p class="mt-3 text-[12.5px] text-[#7a8a84]">
      Secure payment via Stripe. Submissions are reviewed by hand before publishing; we'll follow up if we need
      anything else.
    </p>
  </main>
</Layout>
